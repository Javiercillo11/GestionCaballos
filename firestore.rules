rules_version = '2';

// Reglas de seguridad de Gestión de Caballos.
// - Solo usuarios autenticados Y presentes en /allowedUsers/{uid} acceden a los datos.
// - Se valida el esquema de cada documento (tipos, longitudes, importes enteros en céntimos).
// - Todo lo no contemplado explícitamente queda denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowed() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    function isStatus(v) {
      return v == 'active' || v == 'inactive';
    }

    function isText(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    // Importe en céntimos: entero, no negativo y con un máximo razonable.
    function isCents(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    function timestampsOnCreate(d) {
      return d.createdAt == request.time && d.updatedAt == request.time;
    }

    function timestampsOnUpdate(d) {
      return d.createdAt == resource.data.createdAt && d.updatedAt == request.time;
    }

    // ---------- Usuarios autorizados (se gestionan desde la consola) ----------
    match /allowedUsers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Catálogo de servicios ----------
    function isValidService(d) {
      return d.keys().hasOnly(['name', 'description', 'price', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'description', 'price', 'status', 'createdAt', 'updatedAt'])
        && isText(d.name, 1, 100)
        && isText(d.description, 0, 500)
        && isCents(d.price, 10000000)
        && isStatus(d.status)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /services/{serviceId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidService(request.resource.data)
        && timestampsOnCreate(request.resource.data);
      allow update: if isAllowed() && isValidService(request.resource.data)
        && timestampsOnUpdate(request.resource.data);
      // La app comprueba antes que ningún caballo lo usa (las reglas no pueden
      // consultar colecciones); se recomienda desactivar en lugar de eliminar.
      allow delete: if isAllowed();
    }

    // ---------- Caballos ----------
    function isValidHorse(d) {
      return d.keys().hasOnly(['name', 'clientName', 'services', 'serviceIds', 'totalPrice', 'location',
                               'registrationDate', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'clientName', 'services', 'serviceIds', 'totalPrice', 'location',
                            'registrationDate', 'status', 'createdAt', 'updatedAt'])
        && isText(d.name, 1, 100)
        && isText(d.clientName, 1, 100)
        && isText(d.location, 0, 200)
        && d.services is list && d.services.size() <= 50
        && d.serviceIds is list && d.serviceIds.size() == d.services.size()
        && isCents(d.totalPrice, 500000000)
        && d.registrationDate is string && d.registrationDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isStatus(d.status)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        // Sin servicios el total debe ser 0; con un servicio, debe coincidir con su precio.
        && (d.services.size() != 0 || d.totalPrice == 0)
        && (d.services.size() != 1 || (d.services[0].price is int && d.totalPrice == d.services[0].price
                                       && d.serviceIds[0] == d.services[0].serviceId));
    }

    match /horses/{horseId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidHorse(request.resource.data)
        && timestampsOnCreate(request.resource.data);
      allow update: if isAllowed() && isValidHorse(request.resource.data)
        && timestampsOnUpdate(request.resource.data);
      allow delete: if isAllowed();
    }

    // Cualquier otra ruta: denegada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
